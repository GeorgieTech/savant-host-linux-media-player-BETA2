#!/bin/sh
DIR=$(cd "$(dirname "$0")" && pwd)
export PULSE_SERVER="${PULSE_SERVER:-unix:/var/run/pulse/native}"
export HOME="${HOME:-/home/RPM}"
CONF="${SPOTIFY_STATE:-/data/gigawatt/spotify}"
mkdir -p "$CONF"
# Pulse cookie is optional; system Pulse on this image often has none.
if [ -z "$PULSE_COOKIE" ] && [ -f "$HOME/.config/pulse/cookie" ]; then
  export PULSE_COOKIE="$HOME/.config/pulse/cookie"
fi
# Stale lockfile from a previous crash blocks start.
rm -f "$CONF/lockfile"
# v0.9 binary treats -config_dir as -c (conf override). Long flag is required.
exec "$DIR/go-librespot" --config_dir "$CONF" "$@"
