[Unit]
Description=Gigawatt Beta2 web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=RPM
Group=audio
WorkingDirectory=/data/www
ExecStart=/usr/bin/python3 /data/www/server.py
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Environment=WEBUI_PORT=80
Environment=MUSIC_DIR=/data/music
Environment=STATE_DIR=/data/gigawatt
Environment=PULSE_SERVER=unix:/var/run/pulse/native

[Install]
WantedBy=multi-user.target
